{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=YOUR_SERVER_NAME;Database=LoanRequestDatabase;User Id=YOUR_USERNAME;Password=YOUR_PASSWORD;Trusted_Connection=True;TrustServerCertificate=True;"
    },
    "Jwt": {
        "Key": "YOUR_SUPER_SECRET_MINIMUM_64_CHARACTER_KEY_HERE_FOR_HMACSHA256",
        "Issuer": "LoanRequestAPI",
        "Audience": "LoanRequestUsers"
    },
    "FlutterWave": {
        "Key": "FLWPUBK_TEST-YOUR_FLUTTERWAVE_PUBLIC_KEY_HERE-X"
    },
    "AzureBlobStorage": {
        "ConnectionString": "DefaultEndpointsProtocol=https;AccountName=YOUR_STORAGE_ACCOUNT_NAME;AccountKey=YOUR_AZURE_STORAGE_ACCESS_KEY;EndpointSuffix=core.windows.net",
        "ContainerName": "loan-documents"
    }
}
